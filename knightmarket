<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>KnightMarket — MVP Screens</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>

/* ───────── ADDITIONS ───────── */
.board{flex-wrap:wrap;max-width:2760px}
.persona{width:100%;font-size:18px;font-weight:600;padding:32px 0 0;margin-top:16px;border-top:2px dashed var(--copper-300)}
.persona span{color:var(--copper)}
.rate{color:var(--copper);font-size:11px;font-weight:500;margin-left:4px}
.stars{display:inline-flex;gap:2px}.stars [data-i]{width:14px;height:14px;color:var(--gold)}.stars .off{color:var(--sand-300)}
.stars.lg{gap:8px}.stars.lg [data-i]{width:40px;height:40px}
.stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}
.stat{background:#fff;border-radius:16px;box-shadow:var(--sh-card);padding:12px;display:flex;flex-direction:column;gap:2px}
.stat .n{font-size:20px;font-weight:700;line-height:26px}.stat .d{font-size:11px;color:var(--navy-300);line-height:14px}.stat .up{font-size:11px;color:var(--green);font-weight:500}
.lrow{min-height:56px;display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--sand-300);font-size:14px;padding:8px 0}
.lrow .r{margin-left:auto;display:flex;align-items:center;gap:8px}
.lrow .sub{font-size:12px;color:var(--navy-300)}
.prog{height:6px;background:var(--sand);border-radius:3px;overflow:hidden}.prog i{display:block;height:100%;background:var(--copper);border-radius:3px}
.bar{display:flex;align-items:center;gap:8px;font-size:12px}.bar .prog{flex:1}
.coupon{background:var(--copper);color:#fff;border-radius:16px;padding:16px;position:relative;display:flex;align-items:center;gap:14px}
.coupon::before,.coupon::after{content:"";position:absolute;width:20px;height:20px;border-radius:50%;background:var(--cream);top:calc(50% - 10px)}
.coupon::before{left:-10px}.coupon::after{right:-10px}
.coupon .dash{border-left:2px dashed rgba(255,255,255,.5);height:56px}
.coupon .pct{font-size:28px;font-weight:700;line-height:32px}.coupon .sm{font-size:11px;opacity:.85}
.coupon.mini{padding:12px 14px}.coupon.mini .pct{font-size:20px;line-height:24px}.coupon.mini .dash{height:40px}
.spons{outline:1.5px solid var(--copper-300);outline-offset:-1.5px}
.spons .sp{position:absolute;top:8px;left:8px;background:var(--copper-100);color:var(--copper);padding:0 8px;height:20px;border-radius:8px;font-size:10px;font-weight:600;letter-spacing:.4px;display:flex;align-items:center}
.banner{height:96px;border-radius:16px;background:var(--navy);color:var(--cream-50);display:flex;align-items:center;padding:0 16px;gap:12px;position:relative;overflow:hidden}
.banner .ad{position:absolute;top:8px;right:12px;font-size:9px;letter-spacing:.6px;opacity:.6}
.banner .im{width:56px;height:56px;border-radius:12px;background:var(--copper);display:flex;align-items:center;justify-content:center;flex:none}
.banner .im [data-i]{color:#fff;width:28px;height:28px}
.benefit{background:#fff;border-radius:16px;box-shadow:var(--sh-card);padding:14px;display:flex;gap:12px;align-items:flex-start}
.benefit .ic{width:40px;height:40px;border-radius:12px;background:var(--copper-100);display:flex;align-items:center;justify-content:center;flex:none}
.benefit .ic [data-i]{color:var(--copper)}
.plan{background:#fff;border-radius:16px;border:1.5px solid var(--sand-300);padding:14px;display:flex;flex-direction:column;gap:6px;flex:1}
.plan.on{border-color:var(--copper);box-shadow:var(--sh-card)}
.plan .pr{font-size:18px;font-weight:700}.plan .pr small{font-size:11px;font-weight:400;color:var(--navy-300)}
.plan li{font-size:11px;line-height:16px;color:var(--navy-300);list-style:none;display:flex;gap:4px}
.orghdr{background:var(--navy);padding:16px 16px 20px;color:var(--cream-50);border-radius:0 0 24px 24px;display:flex;gap:12px;align-items:center}
.orghdr .avatar{width:56px;height:56px;background:var(--gold);color:var(--navy)}
.orghdr .badge{color:var(--gold)}.orghdr .sec{color:rgba(250,246,236,.7)}
.sizes{display:flex;gap:8px;flex-wrap:wrap}.sizes div{width:44px;height:36px;border-radius:10px;border:1px solid var(--sand-300);background:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:500}
.sizes .on{background:var(--navy);color:var(--cream-50);border-color:var(--navy)}
.toggle{width:44px;height:26px;border-radius:13px;background:var(--navy);position:relative;flex:none}
.toggle::after{content:"";position:absolute;top:3px;right:3px;width:20px;height:20px;border-radius:50%;background:#fff}
.toggle.off{background:var(--sand-300)}.toggle.off::after{right:auto;left:3px}
.trow{display:flex;align-items:center;justify-content:space-between;background:#fff;border-radius:12px;border:1px solid var(--sand-300);padding:12px 14px}
.mapbox{height:140px;border-radius:16px;background:var(--navy-100);position:relative;overflow:hidden}
.mapbox::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0 39px,rgba(11,42,62,.06) 39px 40px),repeating-linear-gradient(0deg,transparent 0 39px,rgba(11,42,62,.06) 39px 40px)}
.pin{position:absolute;display:flex;flex-direction:column;align-items:center;gap:2px;font-size:10px;font-weight:500}
.pin [data-i]{width:24px;height:24px}
.pin.partner{color:var(--copper)}.pin.partner [data-i]{color:var(--copper)}
.pin.pub{color:var(--navy)}
.hbars{display:flex;align-items:flex-end;gap:6px;height:64px}
.hbars i{flex:1;background:var(--copper-100);border-radius:4px 4px 0 0}.hbars i.hi{background:var(--copper)}
.pill.paid{background:#DDEBE3;color:var(--green);text-transform:none;letter-spacing:0}
.pill.pend{background:var(--copper-100);color:var(--copper);text-transform:none;letter-spacing:0}
.pill.gold{background:var(--gold);color:var(--navy)}
.pill.partner{background:var(--copper-100);color:var(--copper);text-transform:none;letter-spacing:0}
.bigcheck{width:80px;height:80px;border-radius:50%;background:var(--green);display:flex;align-items:center;justify-content:center;margin:0 auto}
.bigcheck [data-i]{width:40px;height:40px;color:#fff}
.review{background:#fff;border-radius:12px;padding:12px;box-shadow:var(--sh-card);display:flex;flex-direction:column;gap:4px}
/* ───────── TOKENS ───────── */
:root{
  --cream-50:#FAF6EC; --cream:#F2EBD9; --sand:#F3E0C2; --sand-300:#E3CBA4;
  --copper-100:#EAD6C7; --copper-300:#C69C82; --copper:#8E5F44; --copper-700:#6B4632;
  --navy-100:#D4DCE2; --navy-300:#6E8290; --navy:#0B2A3E; --navy-700:#061B29;
  --gold:#F2C94C; --green:#3D7A5B; --red:#B4463A; --white:#FFFFFF;
  --sh-card:0 2px 8px rgba(11,42,62,.08);
  --sh-raised:0 4px 16px rgba(11,42,62,.12);
  --sh-sheet:0 -4px 24px rgba(11,42,62,.14);
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Poppins,sans-serif;color:var(--navy);background:#E4DCC8;padding:60px;font-size:14px;line-height:20px}
img{display:block;max-width:100%}
.board{display:flex;gap:60px;align-items:flex-start}
.slot{display:flex;flex-direction:column;gap:12px;flex:none}
.slot>label{font-size:13px;font-weight:600;color:var(--navy-300);letter-spacing:.6px;text-transform:uppercase}

/* ───────── SCREEN FRAME ───────── */
.screen{width:390px;height:844px;background:var(--cream);position:relative;overflow:hidden;flex:none}
.screen.tall{height:auto;min-height:844px}
.status{height:44px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;font-weight:600;font-size:15px}
.status .sig{display:flex;gap:5px;align-items:center}
.status .bat{width:24px;height:11px;border:1.5px solid var(--navy);border-radius:3px;position:relative}
.status .bat::after{content:"";position:absolute;inset:2px;right:4px;background:var(--navy);border-radius:1px}
.pad{padding:0 16px}
.rays{position:absolute;inset:0;pointer-events:none;opacity:.7;object-fit:cover;width:100%;height:100%}
.noise{position:absolute;inset:0;pointer-events:none;opacity:.05;mix-blend-mode:multiply;object-fit:cover;width:100%;height:100%}
.rel{position:relative;z-index:1}

/* ───────── TYPE ───────── */
.display{font-size:28px;line-height:34px;font-weight:600;letter-spacing:-.2px}
.h1{font-size:24px;line-height:30px;font-weight:600;letter-spacing:-.2px}
.h2{font-size:20px;line-height:26px;font-weight:600}
.h3{font-size:16px;line-height:22px;font-weight:600}
.price{font-size:18px;line-height:24px;font-weight:700}
.price-lg{font-size:24px;line-height:30px;font-weight:700;letter-spacing:-.2px}
.body-l{font-size:16px;line-height:24px}
.body-s{font-size:12px;line-height:16px}
.label{font-size:14px;line-height:20px;font-weight:500}
.label-s{font-size:12px;line-height:16px;font-weight:500}
.caption{font-size:11px;line-height:14px;font-weight:500;letter-spacing:.3px}
.sec{color:var(--navy-300)}
.acc{color:var(--copper)}
.center{text-align:center}
.per{font-size:12px;font-weight:400;color:var(--navy-300)}

/* ───────── ICONS ───────── */
[data-i]{display:inline-flex;width:24px;height:24px;flex:none;color:var(--navy);vertical-align:middle}
[data-i] svg{width:100%;height:100%}
.i16{width:16px;height:16px}.i20{width:20px;height:20px}.i28{width:28px;height:28px}.i32{width:32px;height:32px}.i40{width:40px;height:40px}.i64{width:64px;height:64px}
.c-sec{color:var(--navy-300)}.c-acc{color:var(--copper)}.c-white{color:#fff}.c-cream{color:var(--cream-50)}.c-red{color:var(--red)}.c-gold{color:var(--gold)}

/* ───────── COMPONENTS ───────── */
.btn{height:52px;border-radius:12px;display:flex;align-items:center;justify-content:center;gap:8px;font-size:14px;font-weight:500;width:100%}
.btn.md{height:44px}.btn.sm{height:36px;padding:0 14px;width:auto}
.btn.primary{background:var(--navy);color:var(--cream-50)}
.btn.accent{background:var(--copper);color:#fff}
.btn.outline{border:1.5px solid var(--navy);color:var(--navy)}
.btn.ghost{color:var(--copper);height:auto;width:auto}
.input{height:48px;background:#fff;border:1px solid var(--sand-300);border-radius:12px;padding:0 14px;display:flex;align-items:center;gap:10px;font-size:16px;color:var(--navy-300)}
.input.focus{border:1.5px solid var(--navy)}
.input .val{color:var(--navy)}
.field{display:flex;flex-direction:column;gap:6px}
.field>.label{color:var(--navy)}
.search{height:48px;background:#fff;border-radius:16px;box-shadow:var(--sh-card);display:flex;align-items:center;gap:10px;padding:0 14px;color:var(--navy-300);font-size:14px}
.search .val{color:var(--navy);font-weight:500}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{height:32px;padding:0 12px;border-radius:999px;background:var(--copper-100);display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:500;color:var(--navy);white-space:nowrap}
.chip.on{background:var(--copper);color:#fff}
.chip.tag{height:28px;background:var(--sand)}
.chip.filter{background:#fff;border:1px solid var(--sand-300)}
.chip.filter.on{background:var(--navy);color:var(--cream-50);border-color:var(--navy)}
.chip.outline{background:transparent;border:1.5px dashed var(--copper-300);color:var(--copper)}
.pill{height:20px;padding:0 8px;border-radius:8px;display:inline-flex;align-items:center;font-size:11px;font-weight:500;letter-spacing:.3px;text-transform:uppercase}
.pill.rent{background:var(--navy);color:var(--cream-50)}
.pill.pre{background:var(--copper);color:#fff}
.pill.cond{background:var(--sand);color:var(--navy);text-transform:none;letter-spacing:0;font-size:12px}
.badge{display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:500;color:var(--navy)}
.badge [data-i]{width:16px;height:16px}
.avatar{border-radius:999px;background:var(--copper-100);display:flex;align-items:center;justify-content:center;color:var(--copper);flex:none}

/* Card / listing grid */
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.card{background:#fff;border-radius:16px;box-shadow:var(--sh-card);overflow:hidden;position:relative}
.card .im{height:173px;background:var(--sand);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.card .im img{width:60%;height:auto}
.card .im [data-i]{width:56px;height:56px;color:var(--copper)}
.card .pill{position:absolute;top:8px;left:8px}
.card .heart{position:absolute;top:6px;right:6px;width:28px;height:28px;border-radius:999px;background:rgba(255,255,255,.9);display:flex;align-items:center;justify-content:center}
.card .heart [data-i]{width:16px;height:16px}
.card .bd{padding:10px 12px 12px;display:flex;flex-direction:column;gap:4px}
.card .ttl{font-size:12px;line-height:16px;font-weight:500;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.card .bd .badge{margin-top:2px}
/* horizontal small card */
.rail{display:flex;gap:12px;overflow:hidden}
.card.h{width:140px;flex:none}
.card.h .im{height:110px}
.card.h .im [data-i]{width:44px;height:44px}
.card.h .ttl{-webkit-line-clamp:1}
/* tile */
.tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.tile{height:84px;background:#fff;border-radius:16px;box-shadow:var(--sh-card);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;font-size:11px;font-weight:500;letter-spacing:.3px}
.tile [data-i]{width:32px;height:32px}
/* seller card */
.seller{background:var(--sand);border-radius:16px;padding:12px;display:flex;align-items:center;gap:12px}
.seller .avatar{width:44px;height:44px}
.seller .nm{display:flex;align-items:center;gap:6px}
/* section header */
.sh{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.sec-gap{margin-top:24px}

/* Tab bar */
.tabbar{position:absolute;left:0;right:0;bottom:0;height:90px;background:#fff;border-top:1px solid var(--sand-300);display:flex;padding:0 6px;z-index:5}
.screen.tall .tabbar{position:sticky;bottom:0;margin-top:24px}
.tab{width:78px;height:56px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-size:11px;font-weight:500;letter-spacing:.3px;color:var(--navy-300)}
.tab [data-i]{color:var(--navy-300)}
.tab.on{color:var(--navy)}.tab.on [data-i]{color:var(--navy)}
.tab.sell{position:relative}
.tab.sell .fab{width:56px;height:56px;border-radius:999px;background:var(--navy);border:2px solid var(--copper);box-shadow:var(--sh-raised);display:flex;align-items:center;justify-content:center;position:absolute;top:-24px;left:11px}
.tab.sell .fab [data-i]{width:28px;height:28px;color:var(--cream-50)}
.tab.sell span{margin-top:32px;color:var(--navy)}

/* Sticky CTA bar */
.cta{position:absolute;left:0;right:0;bottom:0;height:84px;background:#fff;border-top:1px solid var(--sand-300);padding:16px 16px 0;display:flex;gap:12px;z-index:5}
.screen.tall .cta{position:sticky;bottom:0}
.cta .btn{flex:1}.cta .btn.wide{flex:1.5}

/* Header bars */
.hdr{height:56px;display:flex;align-items:center;gap:12px;padding:0 16px}
.hdr .ttl{flex:1;text-align:center}
.circ{width:40px;height:40px;border-radius:999px;background:rgba(255,255,255,.9);display:flex;align-items:center;justify-content:center;box-shadow:var(--sh-card)}

/* Segmented */
.seg{height:40px;background:var(--sand);border-radius:12px;padding:3px;display:flex}
.seg div{flex:1;display:flex;align-items:center;justify-content:center;border-radius:9px;font-size:13px;font-weight:500;color:var(--navy-300)}
.seg .on{background:#fff;color:var(--navy);box-shadow:var(--sh-card)}
/* Checkbox */
.cb{display:flex;align-items:center;gap:10px;font-size:14px}
.cb i{width:20px;height:20px;border-radius:6px;border:1.5px solid var(--navy-300);display:inline-flex;align-items:center;justify-content:center;flex:none}
.cb.on i{background:var(--navy);border-color:var(--navy)}
.cb.on i svg{width:14px;height:14px}
/* Slider */
.slider{height:24px;position:relative;margin:8px 0 4px}
.slider .tr{position:absolute;top:10px;left:0;right:0;height:4px;background:var(--sand-300);border-radius:2px}
.slider .fl{position:absolute;top:10px;left:0;width:36%;height:4px;background:var(--copper);border-radius:2px}
.slider .th{position:absolute;top:0;width:24px;height:24px;border-radius:999px;background:#fff;box-shadow:var(--sh-raised)}
/* Sheet */
.scrim{position:absolute;inset:0;background:rgba(11,42,62,.4);z-index:8}
.sheet{position:absolute;left:0;right:0;bottom:0;background:#fff;border-radius:24px 24px 0 0;box-shadow:var(--sh-sheet);padding:0 16px 32px;z-index:9;display:flex;flex-direction:column;gap:20px}
.grab{width:40px;height:4px;border-radius:2px;background:var(--navy-100);margin:8px auto 4px}
/* Chat */
.pinned{height:64px;background:#fff;border-bottom:1px solid var(--sand-300);display:flex;align-items:center;gap:12px;padding:0 16px}
.pinned .th{width:48px;height:48px;border-radius:10px;background:var(--sand);display:flex;align-items:center;justify-content:center;color:var(--copper)}
.pinned .th [data-i]{width:28px;height:28px;color:var(--copper)}
.msgs{padding:16px;display:flex;flex-direction:column;gap:10px}
.bub{max-width:280px;padding:10px 14px;border-radius:16px;font-size:14px;line-height:20px}
.bub.me{align-self:flex-end;background:var(--navy);color:var(--cream-50);border-bottom-right-radius:4px}
.bub.them{align-self:flex-start;background:#fff;color:var(--navy);border-bottom-left-radius:4px;box-shadow:var(--sh-card)}
.ts{font-size:11px;color:var(--navy-300);align-self:center;margin:4px 0}
.composer{position:absolute;left:0;right:0;bottom:0;height:90px;background:#fff;border-top:1px solid var(--sand-300);padding:8px 16px 0;display:flex;flex-direction:column;gap:8px}
.composer .row{display:flex;gap:8px;align-items:center}
.composer .in{flex:1;height:44px;border-radius:999px;background:var(--cream);padding:0 16px;display:flex;align-items:center;color:var(--navy-300)}
.composer .send{width:44px;height:44px;border-radius:999px;background:var(--navy);display:flex;align-items:center;justify-content:center}
.composer .send [data-i]{color:var(--cream-50);width:20px;height:20px}
/* Sell photos */
.photos{display:flex;gap:8px}
.photos div{width:80px;height:80px;border-radius:12px;border:1.5px dashed var(--sand-300);display:flex;align-items:center;justify-content:center;color:var(--navy-300)}
.photos div:first-child{background:#fff;border-style:solid;color:var(--navy)}
.textarea{height:120px;align-items:flex-start;padding-top:12px}
/* Detail hero */
.hero{height:390px;background:var(--sand);display:flex;align-items:center;justify-content:center;position:relative}
.hero [data-i]{width:140px;height:140px;color:var(--copper)}
.hero .top{position:absolute;top:52px;left:16px;right:16px;display:flex;justify-content:space-between}
.hero .top .r{display:flex;gap:8px}
.dots{position:absolute;bottom:14px;left:0;right:0;display:flex;justify-content:center;gap:6px}
.dots i{width:6px;height:6px;border-radius:3px;background:rgba(11,42,62,.3)}
.dots i.on{background:var(--navy)}
.detail-row{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--navy-300)}
.detail-row [data-i]{width:16px;height:16px;color:var(--navy-300)}
/* OTP */
.otp{display:flex;gap:8px}
.otp div{width:50px;height:56px;background:#fff;border:1px solid var(--sand-300);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:600}
.otp div.on{border:1.5px solid var(--navy)}
.stepdots{display:flex;gap:8px;justify-content:center}
.stepdots i{width:8px;height:8px;border-radius:4px;background:var(--sand-300)}
.stepdots i.on{background:var(--copper)}
/* Org banner */
.org{background:#fff;border-radius:16px;box-shadow:var(--sh-card);display:flex;overflow:hidden;height:120px}
.org .im{width:120px;background:var(--sand);display:flex;align-items:center;justify-content:center;flex:none}
.org .im [data-i]{width:56px;height:56px;color:var(--copper)}
.org .bd{padding:14px 16px;display:flex;flex-direction:column;gap:4px;justify-content:center}
/* Divider row */
.divrow{display:flex;align-items:center;gap:12px;color:var(--navy-300);font-size:12px;margin:20px 0 12px}
.divrow::before,.divrow::after{content:"";flex:1;height:1px;background:var(--sand-300)}
